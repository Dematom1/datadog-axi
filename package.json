{
  "name": "datadog-axi",
  "version": "0.1.4",
  "description": "Read-first Datadog CLI for agents - AXI-compliant, token-efficient TOON output over the Datadog REST API",
  "type": "module",
  "license": "MIT",
  "author": "Laszlo Horanszky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dematom1/datadog-axi.git"
  },
  "homepage": "https://github.com/Dematom1/datadog-axi#readme",
  "bugs": {
    "url": "https://github.com/Dematom1/datadog-axi/issues"
  },
  "keywords": [
    "datadog",
    "observability",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "bin": {
    "datadog-axi": "./dist/bin/datadog-axi.js",
    "datadog-axi-ctx": "./dist/bin/datadog-axi-ctx.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "skills/datadog-axi",
    "LICENSE",
    "README.md",
    "ROADMAP.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:skill": "npm run build && node dist/scripts/build-skill.js",
    "check:skill": "npm run build && node dist/scripts/build-skill.js --check",
    "prepack": "npm run build && node dist/scripts/build-skill.js --check"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.1",
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.12"
  }
}
